# Next.js Environment Variables
# Copy this file to .env.local and fill in your values

# ===== NEXT.JS PUBLIC VARIABLES (accessible in browser) =====
# These are prefixed with NEXT_PUBLIC_ and exposed to the browser

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://bexyflowers.shop

# Supabase (public keys - safe to expose)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API Keys (frontend auth)
NEXT_PUBLIC_FRONTEND_API_KEY=your-frontend-api-key

# Admin Credentials (localStorage-based, will be migrated to server-side auth)
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=your-secure-password
NEXT_PUBLIC_ADMIN_DISPLAY_NAME=Administrator

# Second Admin (optional)
NEXT_PUBLIC_ADMIN2_USERNAME=admin2
NEXT_PUBLIC_ADMIN2_PASSWORD=your-secure-password-2
NEXT_PUBLIC_ADMIN2_DISPLAY_NAME=Admin2

# Development flags
NEXT_PUBLIC_USE_NETLIFY_FUNCTIONS=false

# ===== SERVER-ONLY VARIABLES (NOT accessible in browser) =====
# These are only available on the server and in API routes

# Supabase Service Role Key (server-only, full access)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# pollinations.ai API Keys (server-only, NEVER expose in frontend)
# Get your API key from: https://enter.pollinations.ai
POLLINATIONS_SECRET_KEY=your-pollinations-api-key
POLLINATIONS_SECRET_KEY2=your-backup-pollinations-api-key-optional

# API Security (server-only)
# Used for backend API authentication - NEVER expose in frontend
FRONTEND_API_SECRET=your-api-secret

# SECURITY NOTE: Do NOT add NEXT_PUBLIC_FRONTEND_API_SECRET or VITE_FRONTEND_API_SECRET
# Exposing secrets in frontend bundles is a security vulnerability.
# Authentication is handled via API key (X-API-Key header) + rate limiting.

# ===== MIGRATION NOTES =====
# Old Vite variables → New Next.js variables
# VITE_SUPABASE_URL → NEXT_PUBLIC_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY → NEXT_PUBLIC_SUPABASE_ANON_KEY
# VITE_SITE_URL → NEXT_PUBLIC_SITE_URL
# VITE_ADMIN_USERNAME → NEXT_PUBLIC_ADMIN_USERNAME
# VITE_ADMIN_PASSWORD → NEXT_PUBLIC_ADMIN_PASSWORD
# VITE_ADMIN_DISPLAY_NAME → NEXT_PUBLIC_ADMIN_DISPLAY_NAME
# VITE_FRONTEND_API_KEY → NEXT_PUBLIC_FRONTEND_API_KEY
# VITE_FRONTEND_API_SECRET → FRONTEND_API_SECRET (server-only now)
# VITE_USE_NETLIFY_FUNCTIONS → NEXT_PUBLIC_USE_NETLIFY_FUNCTIONS
